# Copie para .env.local (dev) ou cadastre na Vercel (Settings → Environment Variables).
# Segredo das sessões/links (mínimo 32 caracteres): npm run hash-password -- --secret
AUTH_SECRET=
ADMIN_USERNAME=Administrador
ADMIN_EMAIL=
# Hash da senha inicial: npm run hash-password
ADMIN_PASSWORD_HASH=
# URL pública (link do e-mail). Na Vercel pode ficar vazio: usa o domínio de produção.
APP_URL=
# E-mail de redefinição (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=
# Gravação da nova senha ao redefinir (Vercel → Storage → Edge Config)
EDGE_CONFIG=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
